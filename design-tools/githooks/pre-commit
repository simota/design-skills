#!/bin/sh
# Budgets enforced by a mechanism rather than by remembering.
# Install with: make hooks
#
# The checks run on what is being committed — the index — not on the working
# tree, so an unstaged fix cannot let a staged violation through, and an
# unstaged mistake cannot block an unrelated commit.
set -e
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/"
python3 "$tmp/design-tools/validate.py"
python3 "$tmp/design-tools/figures_check.py"
